<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DfTools.Desktop.ViewModels"
        xmlns:conv="using:DfTools.Desktop.Converters"
        xmlns:diff="using:DfTools.Diff"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="DfTools.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Settings.Text.AppTitle}"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{Binding Settings.Theme.BackgroundColor}"
        Foreground="{Binding Settings.Theme.PrimaryTextColor}"
        FontFamily="{Binding Settings.Theme.FontFamily}"
        FontSize="{Binding Settings.Theme.FontSize}">

    <Window.Resources>
        <conv:IntEqualsConverter x:Key="IntEqualsConverter" />
        <conv:DiffChangeTypeToBrushConverter x:Key="DiffChangeTypeToBrushConverter" />
        <conv:DiffSubPieceBrushConverter x:Key="DiffSubPieceBrushConverter" />
    </Window.Resources>

    <Window.KeyBindings>
        <KeyBinding Gesture="F1" Command="{Binding ToggleCommandPaletteCommand}" />
        <KeyBinding Gesture="Ctrl+P" Command="{Binding ToggleCommandPaletteCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding ExecuteCurrentToolCommand}" />
        <KeyBinding Gesture="F6" Command="{Binding CopyCurrentToolOutputCommand}" />
        <KeyBinding Gesture="F7" Command="{Binding ClearCurrentToolInputCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- Header / Title Bar -->
        <Border Grid.Row="0"
                Background="{Binding Settings.Theme.SurfaceColor}"
                BorderBrush="{Binding Settings.Theme.BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{Binding Settings.Theme.AccentColor}" Width="10" Height="10" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Settings.Text.AppTitle}"
                               FontWeight="Bold"
                               Foreground="{Binding Settings.Theme.PrimaryTextColor}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="F1 / Ctrl+P: Command Palette"
                               Foreground="{Binding Settings.Theme.SecondaryTextColor}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Tabs Bar (Tools Box) -->
        <Border Grid.Row="1"
                Background="{Binding Settings.Theme.SurfaceColor}"
                BorderBrush="{Binding Settings.Theme.BorderColor}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="2" Margin="8,4,8,0">
                <Button Content="[1] SQL FORMATTER"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="0"
                        BorderThickness="1,1,1,0"
                        CornerRadius="0"
                        Padding="16,8"
                        FontWeight="Bold"
                        Background="{Binding Settings.Theme.ActiveTabBackgroundColor}"
                        Foreground="{Binding Settings.Theme.ActiveTabTextColor}"
                        BorderBrush="{Binding Settings.Theme.BorderColor}" />
                <Button Content="[2] TEXT DIFFER"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="1"
                        BorderThickness="1,1,1,0"
                        CornerRadius="0"
                        Padding="16,8"
                        FontWeight="Bold"
                        Background="{Binding Settings.Theme.ActiveTabBackgroundColor}"
                        Foreground="{Binding Settings.Theme.ActiveTabTextColor}"
                        BorderBrush="{Binding Settings.Theme.BorderColor}" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" Margin="12">
            <!-- TOOL 0: SQL FORMATTER -->
            <Grid Grid.Row="0"
                  IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                  RowDefinitions="Auto, *">

                <!-- Action Toolbar -->
                <Border Grid.Row="0"
                        Background="{Binding Settings.Theme.PanelBackgroundColor}"
                        BorderBrush="{Binding Settings.Theme.BorderColor}"
                        BorderThickness="1"
                        Padding="8"
                        Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding Settings.Text.FormatButtonText}"
                                    Command="{Binding FormatSqlCommand}"
                                    Background="{Binding Settings.Theme.ButtonBackgroundColor}"
                                    Foreground="{Binding Settings.Theme.ButtonTextColor}"
                                    BorderBrush="{Binding Settings.Theme.BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Padding="12,6"
                                    FontWeight="Bold" />

                            <Button Content="{Binding Settings.Text.CopyButtonText}"
                                    Command="{Binding CopySqlCommand}"
                                    Background="{Binding Settings.Theme.ButtonBackgroundColor}"
                                    Foreground="{Binding Settings.Theme.ButtonTextColor}"
                                    BorderBrush="{Binding Settings.Theme.BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Padding="12,6" />

                            <Button Content="{Binding Settings.Text.ClearButtonText}"
                                    Command="{Binding ClearSqlCommand}"
                                    Background="{Binding Settings.Theme.ButtonBackgroundColor}"
                                    Foreground="{Binding Settings.Theme.ButtonTextColor}"
                                    BorderBrush="{Binding Settings.Theme.BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Padding="12,6" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="INPUT: LEFT | OUTPUT: RIGHT"
                                   Foreground="{Binding Settings.Theme.SecondaryTextColor}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Dual Editor View -->
                <Grid Grid.Row="1" ColumnDefinitions="*, 8, *">
                    <!-- Input Box -->
                    <Grid Grid.Column="0" RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="INPUT SQL:" FontWeight="Bold" Margin="0,0,0,4" Foreground="{Binding Settings.Theme.SecondaryTextColor}" />
                        <TextBox Grid.Row="1"
                                 x:Name="SqlInputBox"
                                 Text="{Binding SqlInput, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 Background="{Binding Settings.Theme.EditorBackgroundColor}"
                                 Foreground="{Binding Settings.Theme.PrimaryTextColor}"
                                 BorderBrush="{Binding Settings.Theme.BorderColor}"
                                 BorderThickness="1"
                                 CornerRadius="0"
                                 FontFamily="{Binding Settings.Theme.FontFamily}"
                                 FontSize="{Binding Settings.Theme.EditorFontSize}" />
                    </Grid>

                    <!-- Splitter Divider -->
                    <GridSplitter Grid.Column="1" Background="{Binding Settings.Theme.BorderColor}" ResizeDirection="Columns" />

                    <!-- Output Box -->
                    <Grid Grid.Column="2" RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="FORMATTED SQL OUTPUT:" FontWeight="Bold" Margin="0,0,0,4" Foreground="{Binding Settings.Theme.SecondaryTextColor}" />
                        <TextBox Grid.Row="1"
                                 Text="{Binding SqlOutput}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 Background="{Binding Settings.Theme.EditorBackgroundColor}"
                                 Foreground="{Binding Settings.Theme.PrimaryTextColor}"
                                 BorderBrush="{Binding Settings.Theme.BorderColor}"
                                 BorderThickness="1"
                                 CornerRadius="0"
                                 FontFamily="{Binding Settings.Theme.FontFamily}"
                                 FontSize="{Binding Settings.Theme.EditorFontSize}" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- TOOL 1: TEXT DIFFER -->
            <Grid Grid.Row="0"
                  IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                  RowDefinitions="Auto, *">

                <!-- Action Toolbar -->
                <Border Grid.Row="0"
                        Background="{Binding Settings.Theme.PanelBackgroundColor}"
                        BorderBrush="{Binding Settings.Theme.BorderColor}"
                        BorderThickness="1"
                        Padding="8"
                        Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding Settings.Text.CompareButtonText}"
                                    Command="{Binding CompareDiffCommand}"
                                    Background="{Binding Settings.Theme.ButtonBackgroundColor}"
                                    Foreground="{Binding Settings.Theme.ButtonTextColor}"
                                    BorderBrush="{Binding Settings.Theme.BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Padding="12,6"
                                    FontWeight="Bold" />

                            <Button Content="[EDIT TEXTS]"
                                    Command="{Binding EditDiffInputsCommand}"
                                    Background="{Binding Settings.Theme.ButtonBackgroundColor}"
                                    Foreground="{Binding Settings.Theme.ButtonTextColor}"
                                    BorderBrush="{Binding Settings.Theme.BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Padding="12,6" />

                            <Button Content="{Binding Settings.Text.ClearButtonText}"
                                    Command="{Binding ClearDiffCommand}"
                                    Background="{Binding Settings.Theme.ButtonBackgroundColor}"
                                    Foreground="{Binding Settings.Theme.ButtonTextColor}"
                                    BorderBrush="{Binding Settings.Theme.BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Padding="12,6" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="#1e3a1e" BorderBrush="#333333" BorderThickness="1" Width="14" Height="14" />
                                <TextBlock Text="Inserted" Foreground="{Binding Settings.Theme.SecondaryTextColor}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="#3a1e1e" BorderBrush="#333333" BorderThickness="1" Width="14" Height="14" />
                                <TextBlock Text="Deleted" Foreground="{Binding Settings.Theme.SecondaryTextColor}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="#3a331e" BorderBrush="#333333" BorderThickness="1" Width="14" Height="14" />
                                <TextBlock Text="Modified" Foreground="{Binding Settings.Theme.SecondaryTextColor}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dual View Container -->
                <Grid Grid.Row="1">
                    <!-- EDIT MODE: Dual TextBox Inputs -->
                    <Grid IsVisible="{Binding IsDiffEditMode}" ColumnDefinitions="*, 8, *">
                        <Grid Grid.Column="0" RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="OLD TEXT (ORIGINAL):" FontWeight="Bold" Margin="0,0,0,4" Foreground="{Binding Settings.Theme.SecondaryTextColor}" />
                            <TextBox Grid.Row="1"
                                     Text="{Binding DiffOldInput, Mode=TwoWay}"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="NoWrap"
                                     Background="{Binding Settings.Theme.EditorBackgroundColor}"
                                     Foreground="{Binding Settings.Theme.PrimaryTextColor}"
                                     BorderBrush="{Binding Settings.Theme.BorderColor}"
                                     BorderThickness="1"
                                     CornerRadius="0"
                                     FontFamily="{Binding Settings.Theme.FontFamily}"
                                     FontSize="{Binding Settings.Theme.EditorFontSize}" />
                        </Grid>

                        <GridSplitter Grid.Column="1" Background="{Binding Settings.Theme.BorderColor}" ResizeDirection="Columns" />

                        <Grid Grid.Column="2" RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="NEW TEXT (MODIFIED):" FontWeight="Bold" Margin="0,0,0,4" Foreground="{Binding Settings.Theme.SecondaryTextColor}" />
                            <TextBox Grid.Row="1"
                                     Text="{Binding DiffNewInput, Mode=TwoWay}"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="NoWrap"
                                     Background="{Binding Settings.Theme.EditorBackgroundColor}"
                                     Foreground="{Binding Settings.Theme.PrimaryTextColor}"
                                     BorderBrush="{Binding Settings.Theme.BorderColor}"
                                     BorderThickness="1"
                                     CornerRadius="0"
                                     FontFamily="{Binding Settings.Theme.FontFamily}"
                                     FontSize="{Binding Settings.Theme.EditorFontSize}" />
                        </Grid>
                    </Grid>

                    <!-- DIFF RESULT MODE: Side-by-Side Visual Diff Panes -->
                    <Grid IsVisible="{Binding !IsDiffEditMode}" ColumnDefinitions="*, 8, *">
                        <!-- Old Text Diff Pane -->
                        <Grid Grid.Column="0" RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="OLD TEXT DIFF:" FontWeight="Bold" Margin="0,0,0,4" Foreground="{Binding Settings.Theme.SecondaryTextColor}" />
                            <Border Grid.Row="1"
                                    Background="{Binding Settings.Theme.EditorBackgroundColor}"
                                    BorderBrush="{Binding Settings.Theme.BorderColor}"
                                    BorderThickness="1">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding DiffResult.OldText.Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="diff:DiffPiece">
                                                <Border Background="{Binding Type, Converter={StaticResource DiffChangeTypeToBrushConverter}, ConverterParameter=Background}"
                                                        Padding="4,2">
                                                    <Grid ColumnDefinitions="40, 10, *">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Position}"
                                                                   Foreground="{Binding $parent[Window].((vm:MainViewModel)DataContext).Settings.Theme.SecondaryTextColor}"
                                                                   HorizontalAlignment="Right" />

                                                        <!-- Render full text line when no subpieces exist -->
                                                        <TextBlock Grid.Column="2"
                                                                   IsVisible="{Binding !SubPieces.Count}"
                                                                   Text="{Binding Text}"
                                                                   FontFamily="{Binding $parent[Window].((vm:MainViewModel)DataContext).Settings.Theme.FontFamily}"
                                                                   FontSize="{Binding $parent[Window].((vm:MainViewModel)DataContext).Settings.Theme.EditorFontSize}"
                                                                   Foreground="{Binding Type, Converter={StaticResource DiffChangeTypeToBrushConverter}, ConverterParameter=Foreground}" />

                                                        <!-- Render inline subpieces when available -->
                                                        <ItemsControl Grid.Column="2"
                                                                      IsVisible="{Binding SubPieces.Count}"
                                                                      ItemsSource="{Binding SubPieces}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="diff:DiffPiece">
                                                                    <Border Background="{Binding Type, Converter={StaticResource DiffSubPieceBrushConverter}, ConverterParameter=Background}"
                                                                            BorderBrush="{Binding Type, Converter={StaticResource DiffSubPieceBrushConverter}, ConverterParameter=Border}"
                                                                            BorderThickness="0,0,0,1">
                                                                        <TextBlock Text="{Binding Text}"
                                                                                   FontFamily="{Binding $parent[Window].((vm:MainViewModel)DataContext).Settings.Theme.FontFamily}"
                                                                                   FontSize="{Binding $parent[Window].((vm:MainViewModel)DataContext).Settings.Theme.EditorFontSize}"
                                                                                   Foreground="{Binding Type, Converter={StaticResource DiffSubPieceBrushConverter}, ConverterParameter=Foreground}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <GridSplitter Grid.Column="1" Background="{Binding Settings.Theme.BorderColor}" ResizeDirection="Columns" />

                        <!-- New Text Diff Pane -->
                        <Grid Grid.Column="2" RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="NEW TEXT DIFF:" FontWeight="Bold" Margin="0,0,0,4" Foreground="{Binding Settings.Theme.SecondaryTextColor}" />
                            <Border Grid.Row="1"
                                    Background="{Binding Settings.Theme.EditorBackgroundColor}"
                                    BorderBrush="{Binding Settings.Theme.BorderColor}"
                                    BorderThickness="1">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding DiffResult.NewText.Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="diff:DiffPiece">
                                                <Border Background="{Binding Type, Converter={StaticResource DiffChangeTypeToBrushConverter}, ConverterParameter=Background}"
                                                        Padding="4,2">
                                                    <Grid ColumnDefinitions="40, 10, *">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Position}"
                                                                   Foreground="{Binding $parent[Window].((vm:MainViewModel)DataContext).Settings.Theme.SecondaryTextColor}"
                                                                   HorizontalAlignment="Right" />

                                                        <!-- Render full text line when no subpieces exist -->
                                                        <TextBlock Grid.Column="2"
                                                                   IsVisible="{Binding !SubPieces.Count}"
                                                                   Text="{Binding Text}"
                                                                   FontFamily="{Binding $parent[Window].((vm:MainViewModel)DataContext).Settings.Theme.FontFamily}"
                                                                   FontSize="{Binding $parent[Window].((vm:MainViewModel)DataContext).Settings.Theme.EditorFontSize}"
                                                                   Foreground="{Binding Type, Converter={StaticResource DiffChangeTypeToBrushConverter}, ConverterParameter=Foreground}" />

                                                        <!-- Render inline subpieces when available -->
                                                        <ItemsControl Grid.Column="2"
                                                                      IsVisible="{Binding SubPieces.Count}"
                                                                      ItemsSource="{Binding SubPieces}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="diff:DiffPiece">
                                                                    <Border Background="{Binding Type, Converter={StaticResource DiffSubPieceBrushConverter}, ConverterParameter=Background}"
                                                                            BorderBrush="{Binding Type, Converter={StaticResource DiffSubPieceBrushConverter}, ConverterParameter=Border}"
                                                                            BorderThickness="0,0,0,1">
                                                                        <TextBlock Text="{Binding Text}"
                                                                                   FontFamily="{Binding $parent[Window].((vm:MainViewModel)DataContext).Settings.Theme.FontFamily}"
                                                                                   FontSize="{Binding $parent[Window].((vm:MainViewModel)DataContext).Settings.Theme.EditorFontSize}"
                                                                                   Foreground="{Binding Type, Converter={StaticResource DiffSubPieceBrushConverter}, ConverterParameter=Foreground}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Command Palette Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="4"
              Background="#CC000000"
              IsVisible="{Binding IsCommandPaletteOpen}">
            <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0"
                    Background="{Binding Settings.Theme.SurfaceColor}"
                    BorderBrush="{Binding Settings.Theme.BorderColor}"
                    BorderThickness="1"
                    Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Settings.Text.CommandPaletteHeader}"
                                   FontWeight="Bold"
                                   Foreground="{Binding Settings.Theme.PrimaryTextColor}" />
                        <Button Grid.Column="1" Content="[ESC]"
                                Command="{Binding ToggleCommandPaletteCommand}"
                                Background="Transparent"
                                Foreground="{Binding Settings.Theme.SecondaryTextColor}"
                                BorderThickness="0" />
                    </Grid>

                    <StackPanel Spacing="6" Margin="0,8,0,0">
                        <Border Background="{Binding Settings.Theme.PanelBackgroundColor}" BorderBrush="{Binding Settings.Theme.BorderColor}" BorderThickness="1" Padding="8">
                            <Grid ColumnDefinitions="Auto, *">
                                <TextBlock Grid.Column="0" Text="[F5]" Width="100" FontWeight="Bold" Foreground="{Binding Settings.Theme.PrimaryTextColor}" />
                                <TextBlock Grid.Column="1" Text="Process Active Tool (Format / Compare Diff)" Foreground="{Binding Settings.Theme.PrimaryTextColor}" />
                            </Grid>
                        </Border>
                        <Border Background="{Binding Settings.Theme.PanelBackgroundColor}" BorderBrush="{Binding Settings.Theme.BorderColor}" BorderThickness="1" Padding="8">
                            <Grid ColumnDefinitions="Auto, *">
                                <TextBlock Grid.Column="0" Text="[F6]" Width="100" FontWeight="Bold" Foreground="{Binding Settings.Theme.PrimaryTextColor}" />
                                <TextBlock Grid.Column="1" Text="Copy Active Tool Output" Foreground="{Binding Settings.Theme.PrimaryTextColor}" />
                            </Grid>
                        </Border>
                        <Border Background="{Binding Settings.Theme.PanelBackgroundColor}" BorderBrush="{Binding Settings.Theme.BorderColor}" BorderThickness="1" Padding="8">
                            <Grid ColumnDefinitions="Auto, *">
                                <TextBlock Grid.Column="0" Text="[F7]" Width="100" FontWeight="Bold" Foreground="{Binding Settings.Theme.PrimaryTextColor}" />
                                <TextBlock Grid.Column="1" Text="Clear Active Tool Inputs" Foreground="{Binding Settings.Theme.PrimaryTextColor}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar Footer -->
        <Border Grid.Row="3"
                Background="{Binding Settings.Theme.SurfaceColor}"
                BorderBrush="{Binding Settings.Theme.BorderColor}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="STATUS:"
                               FontWeight="Bold"
                               Foreground="{Binding Settings.Theme.SecondaryTextColor}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontWeight="Bold"
                               Foreground="{Binding Settings.Theme.StatusOkColor}" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="DFTOOLS v1.0.0 | KEYBOARD-FIRST EDITION"
                           Foreground="{Binding Settings.Theme.SecondaryTextColor}" />
            </Grid>
        </Border>

    </Grid>

</Window>

